# --- Supabase (leave unset to run in demo mode with in-memory sample data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (optional; notifications are stored in-app regardless) ---
RESEND_API_KEY=
EMAIL_FROM=ProofFlow <notifications@example.com>

# --- ClickUp (optional; can also be configured per-company in Settings) ---
CLICKUP_WEBHOOK_SECRET=
