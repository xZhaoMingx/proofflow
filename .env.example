# --- Supabase (leave unset to run in demo mode with in-memory sample data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Demo-mode team registration code: required to create an account (email +
# password logins) when Supabase auth isn't set up. Blank = anyone can sign up.
APP_PASSWORD=

# --- Email (optional; notifications are stored in-app regardless) ---
RESEND_API_KEY=
EMAIL_FROM=ProofFlow <notifications@example.com>

# --- ClickUp (optional; can also be configured per-company in Settings) ---
# App-wide API key: customer submissions create tasks in a "ProofFlow" list
# (or CLICKUP_LIST_ID if set). A connection saved in Settings takes precedence.
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
CLICKUP_WEBHOOK_SECRET=
